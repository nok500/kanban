{
  "name": "kanban-job-board",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "e2e": "turbo run e2e",
    "e2e:ui": "pnpm --filter @doska/e2e e2e:ui",
    "e2e:container": "pnpm --filter @doska/e2e e2e:container",
    "test:install": "bash .github/scripts/install-test.sh",
    "test:selfhost": "bash .github/scripts/selfhost-smoke.sh",
    "test:selfhost:data": "bash .github/scripts/selfhost-data.sh",
    "test:selfhost:upgrade": "bash .github/scripts/selfhost-upgrade.sh",
    "test:selfhost:restore": "bash .github/scripts/selfhost-restore.sh",
    "selfhost:down": "docker compose down --volumes --remove-orphans",
    "local:up": "docker compose -f docker-compose.local.yml up -d --build",
    "local:build": "docker compose -f docker-compose.local.yml build",
    "local:logs": "docker compose -f docker-compose.local.yml logs -f --tail=100",
    "local:down": "docker compose -f docker-compose.local.yml down",
    "upd": "pnpm dlx npm-check-updates --workspaces --root -i"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "turbo": "^2.11.5"
  }
}
