# Copy to .env next to docker-compose.yml.
# Docs: https://github.com/nok500/kanban#readme/self-hosting

# ---- Required -----------------------------------------------------------------

# Sign-in credentials for the web UI and desktop sync.
AUTH_LOGIN=admin
AUTH_PASSWORD=change-me

# Signs session tokens. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Public origin of this server, no trailing slash.
# e.g. http://192.168.1.10:8080 or https://kanban.example.com
BASE_URL=

# Set to false to let the web UI work signed out, with boards kept in the
# browser only. Default: true
# ALWAYS_AUTH=true

# ---- Network ------------------------------------------------------------------

# Host port for the web UI.
WEB_PORT=8080

# Automatic HTTPS via Caddy (Let's Encrypt). Point DNS at this host, set
# BASE_URL=https://<DOMAIN> above, then start with `--profile https`.
# DOMAIN=kanban.example.com

# ---- Single sign-on (optional) ------------------------------------------------
# Any OpenID Connect provider (Authentik, Keycloak, Pocket ID, Google).
# Register a web app with redirect URI $BASE_URL/api/auth/oauth2/callback/oidc
# and scopes openid, profile, email. Setting OIDC_ISSUER turns SSO on.
# Docs: https://github.com/nok500/kanban#readme/user-guides/sso

# OIDC_ISSUER=https://auth.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# Label on the sign-in button: "Continue with <OIDC_NAME>". Default: SSO
# OIDC_NAME=
# Set to off to stop SSO sign-ins from creating new accounts. Default: on
# OIDC_AUTO_CREATE=on

# ---- Database -----------------------------------------------------------------

# Password for the bundled Postgres (data lives in a Docker volume).
POSTGRES_PASSWORD=change-me

# Use your own Postgres instead. The bundled one is then ignored.
# DATABASE_URL=postgres://user:password@db-host:5432/kanban

# ---- Attachments (optional) ---------------------------------------------------
# Stored on a Docker volume by default. Set S3_BUCKET to store them in S3
# instead. The bucket stays private: the server proxies uploads and downloads.

# S3_BUCKET=my-kanban-attachments
# S3_REGION=us-east-1
# Needs s3:PutObject, s3:GetObject, s3:DeleteObject.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# For S3-compatible stores (MinIO, Cloudflare R2).
# S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com

# Max upload size in bytes. Default: 25 MiB
# FILE_MAX_BYTES=26214400

# ---- Card chat (optional) ----------------------------------------------------
# llama.cpp servers (OpenAI-compatible API) the card "Chat" button talks to,
# proxied by the server. Easiest: add them in the web UI as an admin, under
# Settings → LLM endpoints (full domains, an optional API key). Entries here
# show up there read-only. Comma-separated `Name|API URL[|UI URL]`: the API URL
# is called from the server container, the UI URL is opened by your browser.
# LLAMA_ENDPOINTS=verdun|http://192.168.8.220:8081/v1|http://verdun:8081/,voodoo|http://192.168.8.229:8081/v1

# ---- pi agent (optional) ----------------------------------------------------
# The `pi` card tag runs the pi coding agent in agent-runner against an
# OpenAI-compatible server (llama.cpp, ...). LOCAL_PROVIDERS lists them, tried in
# order: a JSON list or comma-separated, `host:port/v1|api-key` for one with a
# key. They're called from inside the container (LAN IPs, not localhost).
# LOCAL_PROVIDERS=["192.168.8.229:8080/v1", "192.168.8.207:8080/v1"]
# Model to ask for; empty picks one the server has loaded.
# PI_MODEL=
# Without LOCAL_PROVIDERS, pi uses its own config (~/.pi) and PI_PROVIDER.
# PI_PROVIDER=
# PI_PACKAGE=/usr/local/lib/node_modules/@earendil-works/pi-coding-agent
# PI_CONFIG=/home/you/.pi

# ---- Updates ------------------------------------------------------------------

# Image tag to pull: latest (stable), beta (prereleases), or a pinned version
# like 0.4.0. The desktop app follows whatever the server runs.
# DOCKER_IMAGE_TAG=latest
